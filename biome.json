{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/build",
      "!!**/dist",
      "!!**/.cache",
      "!!**/coverage",
      "!!**/playwright-report",
      "!!**/test-results",
      "!!package-lock.json",
      "!!packages/ir/src/generated/design-document.ts",
      "!!docs/schema-reference.md"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "json": {
    "formatter": {
      "enabled": true
    }
  },
  "overrides": [
    {
      "includes": ["tests/**"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ]
}
